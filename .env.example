# SafeGuard - Environment Configuration

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0.2

# Amazon Rekognition
REKOGNITION_COLLECTION_ID=safeguard-family-faces
REKOGNITION_CONFIDENCE_THRESHOLD=90.0

# DynamoDB Tables
DYNAMODB_EVENTS_TABLE=safeguard-events
DYNAMODB_PATTERNS_TABLE=safeguard-patterns
DYNAMODB_FAMILY_TABLE=safeguard-family-profiles
DYNAMODB_SETTINGS_TABLE=safeguard-user-preferences

# Amazon SNS Topics
SNS_CRITICAL_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:safeguard-critical-alerts
SNS_MEDIUM_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:safeguard-medium-alerts
SNS_DIGEST_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:safeguard-daily-digests

# Ring API Configuration
RING_API_KEY=mock_ring_token
RING_LOCATION_ID=loc_home_01
RING_RATE_LIMIT_RPS=20

# SafeGuard Preferences
SAFEGUARD_LANGUAGE=en
SAFEGUARD_QUIET_HOURS_START=23:00
SAFEGUARD_QUIET_HOURS_END=07:00
SAFEGUARD_OFFLINE_MOCK_MODE=true
